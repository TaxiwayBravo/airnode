[Unit]
Description=AirNode Beast feed to %i
After=network-online.target airnode-receiver.service
Wants=network-online.target airnode-receiver.service

[Service]
User=airnode-radio
Group=airnode
WorkingDirectory=/opt/airnode
ExecStart=/usr/bin/python3 -m airnode.feeder %i
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
